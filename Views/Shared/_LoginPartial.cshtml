@using Microsoft.AspNetCore.Identity
@using HoerskoolDieAdelaar.Areas.Identity.Data

@inject SignInManager<HoerskoolDieAdelaarUser> SignInManager
@inject UserManager<HoerskoolDieAdelaarUser> UserManager




   
    



<ul class="navdiv">


